{
  "manifest_version": 3,
  "name": "Proven",
  "version": "0.1.0",
  "description": "Checks a founder's factual claims live during Google Meet and Zoom calls, with sources.",
  "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Proven" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["captions.js", "meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.zoom.us/*", "https://*.zoom.us/wc/*"],
      "js": ["captions.js", "zoom.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
